rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny for all unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Users Profile Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Disallow querying across all users
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['name', 'email'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 150;
      allow update: if isOwner(userId)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100;
      allow delete: if isOwner(userId);
    }

    // 2. Animals Collection (Herd Roster & Passports)
    match /animals/{animalId} {
      allow list: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.breed is string;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 3. Smart Tasks Collection
    match /tasks/{taskId} {
      allow list: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 4. Advisor Messages History
    match /advisorMessages/{messageId} {
      allow list: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 10000;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 5. Market Listings (Public Read, Owner Manage)
    match /marketListings/{listingId} {
      allow read: if true; // Public marketplace catalogue
      allow create: if isSignedIn()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && (!('price' in request.resource.data) || request.resource.data.price >= 0);
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 150;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 6. Market Orders (Buyer & Seller Access)
    match /marketOrders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        resource.data.buyerPhone == request.auth.token.phone_number
      );
      allow create: if isSignedIn()
        && request.resource.data.itemTitle is string
        && request.resource.data.totalAmount >= 0;
      allow update: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
      allow delete: if false; // Immutable audit preservation for financial orders
    }

    // 7. Notifications Collection
    match /notifications/{notifId} {
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }
  }
}
